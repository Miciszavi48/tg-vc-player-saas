# Local disposable PostgreSQL for schema/migration validation (Windows).
# Copy to app/config.env.disposable (gitignored) and adjust password if needed.
# Do not use for production. Do not commit config.env.disposable.

DATABASE_URL=postgresql+asyncpg://musicbot:devpassword@127.0.0.1:5432/musicbot_disposable
TEST_DATABASE_URL=postgresql+asyncpg://musicbot:devpassword@127.0.0.1:5432/musicbot_disposable

# Alembic (from app/):
#   cd app
#   $env:DATABASE_URL = (Get-Content ..\app\config.env.disposable | Where-Object { $_ -match '^DATABASE_URL=' }) -replace '^DATABASE_URL=',''
#   alembic upgrade head
#
# DB validation (from repo root; auto-loads this file when present):
#   python scripts/db_schema_drift_check.py
#   python scripts/validate_daily_deduct_batching.py
#   python scripts/run_disposable_alembic_check.py
