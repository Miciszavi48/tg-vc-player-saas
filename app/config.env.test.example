# Test-only environment template.
# Copy to app/config.env.test only for local smoke or CI-style validation.
# Do not use this file for production.

TEST_MODE=true

BOT_TOKEN=test
API_ID=12345
API_HASH=testhash
# Comma-separated for multiple developers (optional).
DEVELOPER_ID=123456789

DATABASE_URL=postgresql+asyncpg://musicbot:devpassword@localhost:5433/musicbot_test
TEST_DATABASE_URL=postgresql+asyncpg://musicbot:devpassword@localhost:5433/musicbot_test
REDIS_URL=redis://localhost:6380/0

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

REDIS_SETTINGS_TTL=60
REDIS_CREDIT_TTL=60
LOG_LEVEL=INFO
