# MusicBot per-instance environment. setup_server.sh fills instance-owned values.

# Required instance identity
INSTANCE_ID=musicbot-a
INSTANCE_ROOT=/opt/musicbot-a
INSTANCE_DATA_DIR=/opt/musicbot-a/var
DATABASE_ISOLATION_MODE=database

# Telegram credentials and owner/developer boundary
BOT_TOKEN=CHANGE_ME_BOT_TOKEN
API_ID=0
API_HASH=CHANGE_ME_API_HASH
DEVELOPER_ID=0
HELPER_PHONE=

# Dedicated PostgreSQL database; sharing one schema is not supported
DATABASE_URL=postgresql+asyncpg://musicbot_musicbot_a:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/musicbot_musicbot_a
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ALLOW_CREATE_ALL=false

# Redis server may be shared because every key is prefixed with root + INSTANCE_ID
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE_ROOT=musicbot
REDIS_SETTINGS_TTL=300
REDIS_CREDIT_TTL=60

# Instance-owned runtime paths
DOWNLOADS_PATH=/opt/musicbot-a/var/downloads
SESSION_PATH=/opt/musicbot-a/var/sessions
LOG_FILE=/opt/musicbot-a/var/logs/bot.log
MEDIA_CACHE_PATH=/opt/musicbot-a/var/cache
TEMP_PATH=/opt/musicbot-a/var/tmp
BACKUP_DIR=/opt/musicbot-a/var/backups
RUNTIME_PATH=/run/musicbot-musicbot-a
PID_FILE=/run/musicbot-musicbot-a/musicbot.pid
LOCK_FILE=/run/musicbot-musicbot-a/musicbot.lock

# Optional local endpoints; 0 disables
HEALTH_HOST=127.0.0.1
HEALTH_PORT=0
METRICS_HOST=127.0.0.1
METRICS_PORT=0

# Safe instance-specific reload signal
BOT_RELOAD_ENABLED=true
BOT_RELOAD_SENTINEL_PATH=/run/musicbot-musicbot-a/reload.request
BOT_RELOAD_COMMAND=
BOT_RELOAD_TIMEOUT_SEC=15

# Encryption keys must be unique secrets per instance
HELPER_SESSION_KEY_CURRENT=CHANGE_ME_HELPER_SESSION_FERNET_KEY
HELPER_SESSION_KEY_OLD=
YOUTUBE_COOKIE_KEY_CURRENT=CHANGE_ME_YOUTUBE_COOKIE_FERNET_KEY
YOUTUBE_COOKIE_KEY_OLD=
YOUTUBE_COOKIE_FINGERPRINT_KEY=CHANGE_ME_YOUTUBE_COOKIE_FINGERPRINT_KEY
FAST_CREAT_TOKEN_KEY_CURRENT=CHANGE_ME_FAST_CREAT_TOKEN_FERNET_KEY
FAST_CREAT_TOKEN_KEY_OLD=
FAST_CREAT_TOKEN_FINGERPRINT_KEY=CHANGE_ME_FAST_CREAT_TOKEN_FINGERPRINT_KEY

# Media and helper limits
VIDEO_QUALITY=720
MAX_DOWNLOAD_SIZE_MB=200
DOWNLOAD_SEMAPHORE=10
MEDIA_CACHE_MAX_GB=10
MEDIA_CACHE_TARGET_GB=8
MEDIA_CACHE_MAX_AGE_HOURS=24
TRANSCODE_POOL_SIZE=4
HELPER_DEFAULT_MAX_CALLS=50
HELPER_DEFAULT_MAX_JOINS_PER_HOUR=300
HELPER_JOIN_INVITE_SETTLE_SECONDS=1
GROUP_CALL_CREATE_SETTLE_SECONDS=1
VC_JOIN_SETTLE_SECONDS=0.5
RECOVERY_GLOBAL_PER_SECOND=5
RECOVERY_MAX_CONCURRENT=10
RECOVERY_JITTER_MS=150
RECOVERY_HELPER_PER_MINUTE=120

# Business defaults
TRIAL_DAYS=3
BASE_CREDIT_RATE=50000
MUSIC_RATE=10000
VIDEO_RATE=25000
SECURITY_CALL_RATE=15000
MAX_GROUP_MEMBERS=0
MAX_CHANNEL_ADMINS=0
DAILY_DEDUCT_BATCHING_ENABLED=false
DAILY_DEDUCT_BATCH_SIZE=200
SUDO_WALLET_LOW_THRESHOLD_DAYS=7

# Links, logs, and retention
LOG_CHANNEL_ID=0
START_TEXT=
DEVELOPER_LINK=
BOT_CHANNEL_LINK=
SUPPORT_GROUP_LINK=
GUIDE_CHANNEL_LINK=
BACKUP_RETENTION_DAYS=7
LOG_LEVEL=INFO
